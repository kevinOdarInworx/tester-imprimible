# Copia este archivo a .env y completa los valores reales.
# .env NUNCA se commitea (esta en .gitignore).

# Credenciales de la base (RAWDB / DM_DBA)
DB_USER=DM_DBA
DB_PASSWORD=changeme

# Bastion SSH.
SSH_BASTION=132.145.197.201
SSH_USER=ctgds

# Este proyecto no trae copia propia de la clave SSH ni del Instant Client
# (pesado, ~500MB, y la clave es sensible): reusa los de generar-imprimibles.
# Si esta carpeta se mueve a otra maquina sin generar-imprimibles al lado,
# hay que copiar esos dos recursos o ajustar estas rutas.
SSH_KEY_PATH=..\generar-imprimibles\keys\ctgds
ORACLE_CLIENT_LIB=..\generar-imprimibles\oracle\instantclient_19_13

# Flujo OIC JASPER_INSOR (mismo usado por generar-imprimibles para descargar PDFs)
OIC_USER=insis.api
OIC_PASSWORD=changeme
